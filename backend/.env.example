# Copy this to .env and fill in real values

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/servisaku

# JWT Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase (optional, for file storage)
SUPABASE_URL=
SUPABASE_KEY=

# Payments — Billplz SANDBOX. Sign up free at https://www.billplz-sandbox.com
# using intern@leontra.com, create a Collection, then fill these in:
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=

# Payments — iPay88. No self-serve sandbox exists; requires a manually-approved
# merchant account from support@ipay88.com.my. Leave blank until obtained —
# the iPay88 gateway is stubbed (returns 503) until these are set.
IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=

# Public URL this server is reachable at, so Billplz can reach the callback
# endpoint. In local dev this needs a tunnel (e.g. ngrok) — Billplz cannot
# reach http://localhost. Use POST /payments/{id}/sync to verify manually
# in the meantime.
APP_PUBLIC_BASE_URL=http://localhost:8000

PAYMENT_CURRENCY=MYR

# Media uploads — Cloudinary FREE TIER. Sign up at
# https://cloudinary.com/users/register/free using intern@leontra.com, then
# copy the Cloud Name / API Key / API Secret from the dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_SIZE_MB=10

# Push — Firebase Cloud Messaging (Spark/FREE plan). Create a project at
# https://console.firebase.google.com using intern@leontra.com, then
# Project Settings > Service Accounts > Generate new private key. Copy
# project_id/client_email/private_key out of the downloaded JSON — never
# commit the JSON file itself. private_key keeps its literal \n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email — tried in this order: Resend, then Brevo, then MailerSend. All three
# have a free tier; sign up with intern@leontra.com. Only providers with an
# API key set are used — leave the ones you don't have blank.
RESEND_API_KEY=
BREVO_API_KEY=
MAILERSEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@servisaku.com
EMAIL_FROM_NAME=ServisAku

# Smart Dispatch — sequential job-offer queue tuning. Defaults are sane for
# production; only override for local testing (e.g. a longer offer timeout
# to compensate for slow manual testing).
DISPATCH_OFFER_TIMEOUT_SECONDS=90
DISPATCH_MAX_CANDIDATES=5
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_SEARCH_RADIUS_KM_CAP=50
DISPATCH_SWEEP_INTERVAL_SECONDS=20

# CORS — also used as Socket.IO's cors_allowed_origins (see
# services/realtime/socket_server.py)
ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Debug mode
DEBUG=true
