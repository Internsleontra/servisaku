// ════════════════════════════════════════════════════════════════════════════
// TARGET SCHEMA — PostgreSQL (Phase 0→1)
// This is the prepared replacement for prisma/schema.prisma, applied when the
// PostgreSQL migration runs (see docs/07-postgres-migration.md).
//
// Contents:
//   §1  Existing models carried over (string-JSON fields upgraded to Json)
//   §2  Booking extensions for the service abstraction (details Json, BookingItem)
//   §3  Catalog tables — DB-driven service abstraction (replaces src/lib/catalog/*
//       and src/lib/packageData.js as source of truth; seeded from them)
//   Phase 2 models (PartnerProfile, Payment, JobOffer, …) are sketched in
//   docs/03-target-architecture.md §3 and added when that phase starts.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── §1 Existing models ──────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  firebaseUid     String?  @unique
  passwordHash    String?
  fullName        String
  role            String   @default("consumer") // consumer | partner | admin | super_admin
  phone           String?
  city            String?
  bio             String?
  avatarUrl       String?
  partnerVerified Boolean  @default(false)
  partnerRating   Float?
  partnerCategory String?
  bankAccount     String?
  availability    Json? // partner availability config (working days/hours, vacation, radius, …)
  partnerProfile  Json? // extended onboarding profile (gender, dob, experience, languages, vehicle, business, portfolio, tax)
  onboardingDraft Json? // in-progress onboarding form (autosaved)
  onboardedAt     DateTime?
  consumerProfile Json?    // consumer onboarding: { gender, birthday, referralCode, referredBy }
  addresses       Json?    // saved service addresses: [{ id, label, ...fields, lat, lng, isDefault }]
  profileComplete Boolean  @default(false) // false after phone-only signup until profile is completed
  tokenVersion    Int      @default(0)     // bump to revoke all refresh tokens (logout everywhere)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookingsAsConsumer Booking[]      @relation("ConsumerBookings")
  bookingsAsPartner  Booking[]      @relation("PartnerBookings")
  reviews            Review[]
  notifications      Notification[]
  notificationPref   NotificationPreference?
  pushTokens         PushToken[]
  specializations    PartnerSpecialization[]
  documents          PartnerDocument[]
  training           TrainingProgress[]
  supportTickets     SupportTicket[]
  inventory          InventoryItem[]
  wallet             PartnerWallet?
  bankAccountDetail  PartnerBankAccount?
  uploads            UploadedFile[]

  @@index([role, partnerVerified])
}

// Support tickets raised by partners (or consumers).
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  category  String // technical | payment | booking | report_customer | other
  subject   String
  message   String
  status    String   @default("open") // open | resolved
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Partner-managed inventory (tools, consumables, equipment).
model InventoryItem {
  id                String   @id @default(cuid())
  partnerId         String
  name              String
  type              String // product | consumable | equipment
  qty               Int      @default(0)
  unit              String?
  lowStockThreshold Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partner User @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// Per-partner training progress (course catalogue is authored in code).
model TrainingProgress {
  id          String    @id @default(cuid())
  partnerId   String
  courseId    String
  status      String    @default("completed") // in_progress | completed
  score       Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  partner User @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, courseId])
  @@index([partnerId])
}

// Partner KYC / compliance documents (Malaysia). One row per submitted doc type.
model PartnerDocument {
  id              String    @id @default(cuid())
  partnerId       String
  type            String // mykad | selfie | skill_cert | insurance | bank | ssm | driving_licence | lhdn
  status          String    @default("pending") // pending | verified | rejected | expired
  fileUrl         String?
  number          String? // IC / SSM / licence / tax number
  expiryDate      DateTime?
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  partner User @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, type])
  @@index([partnerId])
}

model Booking {
  id             String    @id @default(cuid())
  serviceType    String // display label (legacy)
  serviceId      String? // legacy column: carries package display name (Phase 1 cleans up)
  status         String    @default("pending")
  price          Float
  date           DateTime
  timeSlot       String?
  address        String?
  city           String?
  notes          String?
  couponCode     String?
  discountAmount Float     @default(0)
  paymentMethod  String?
  paymentStatus  String    @default("pending")
  consumerId     String
  partnerId      String?
  // §2 service-abstraction extensions
  categoryId     String?
  catalogServiceId String?
  packageId      String?
  details        Json? // service-specific answers from workflow params (BHK, unit count, …) — also the dynamic Step-A answer snapshot
  priceBreakdown Json? // computePrice() snapshot (line items + fees) — invoices never recalc from current config
  configVersion  String? // servisaku-services-config.json version in force at booking time
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  lifecycle      Json? // timestamped status transitions
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  consumer       User            @relation("ConsumerBookings", fields: [consumerId], references: [id])
  partner        User?           @relation("PartnerBookings", fields: [partnerId], references: [id])
  category       ServiceCategory? @relation(fields: [categoryId], references: [id])
  catalogService Service?        @relation(fields: [catalogServiceId], references: [id])
  items          BookingItem[]
  escrow         EscrowLedger?
  review         Review?
  refundRequests RefundRequest[]
  chatMessages   ChatMessage[]
  payments       Payment[]

  @@index([consumerId, status])
  @@index([partnerId, status])
  @@index([date])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountType       String
  discountValue      Float
  maxDiscountCap     Float?
  minOrderAmount     Float?
  applicableServices Json? // was comma-separated string on SQLite
  isActive           Boolean   @default(true)
  validUntil         DateTime?
  usageCount         Int       @default(0)
  maxUsage           Int?
  createdAt          DateTime  @default(now())
}

model Review {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  userId       String
  rating       Float
  comment      String?
  photos       Json? // was JSON-in-string on SQLite
  reply        String? // partner's public reply
  repliedAt    DateTime?
  reported     Boolean   @default(false) // partner flagged for moderation
  reportReason String?
  createdAt    DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

// ─── Payments (gateway abstraction: mock | billplz | stripe | cash) ──────────
// NOTE ON UNITS: `amount` is in **sen** (integer-valued) because that is what the
// gateways transact in; `amountMyr` mirrors it in ringgit, matching Booking.price
// and every model in §5. Only the provider adapters convert between the two.
model Payment {
  id          String    @id @default(cuid())
  bookingId   String
  amount      Float // sen
  amountMyr   Float? // ringgit mirror of `amount`
  currency    String    @default("MYR")
  method      String // fpx | duitnow | card | applepay | googlepay | tng | grabpay | boost | cash
  provider    String    @default("mock") // mock | billplz | stripe | cash
  status      String    @default("pending") // pending | paid | failed | refunded
  // What this payment settles. `booking` is a consumer paying for a service;
  // `commission_settlement` is a partner paying ServisAku what they owe on cash jobs.
  type        String    @default("booking") // booking | commission_settlement | damage_compensation
  partnerId   String? // payer, when the payer is a partner rather than the consumer
  settlementId String?
  gatewayRef  String? // gateway bill / transaction id
  checkoutUrl String? // hosted checkout URL (real gateways)
  refundedAmount Float  @default(0) // MYR, cumulative — supports repeated partial refunds
  sstAmount   Float     @default(0) // MYR
  platformFee Float     @default(0) // MYR — commission snapshot at payment time
  netToPartner Float    @default(0) // MYR
  collectedById String? // partner user id who recorded a cash collection
  idempotencyKey String? @unique
  paidAt      DateTime?
  raw         Json? // gateway payload snapshot
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([gatewayRef])
  @@index([type, status])
  @@index([partnerId])
}

// Idempotency ledger for gateway webhooks — a given (provider,eventId) is processed once.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String?
  payload     Json?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model EscrowLedger {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  grossAmount   Float
  platformFee   Float
  partnerPayout Float
  status        String    @default("held")
  freezeReason  String?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

model RefundRequest {
  id             String   @id @default(cuid())
  bookingId      String
  consumerId     String
  originalAmount Float
  refundAmount   Float
  refundType     String
  reason         String
  status         String   @default("pending")
  adminNote      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

model PayoutRecord {
  id               String    @id @default(cuid())
  partnerId        String
  partnerName      String
  grossEarning     Float
  commissionAmount Float
  netPayout        Float
  payoutMethod     String    @default("Bank Transfer")
  // pending | scheduled | processing | completed | failed | cancelled
  status           String    @default("pending")
  failureReason    String?
  scheduledDate    DateTime?
  createdAt        DateTime  @default(now())
  // ── Batch / period context ────────────────────────────────────────────────
  batchId            String?
  cycle              String    @default("manual") // weekly | monthly | manual
  periodStart        DateTime?
  periodEnd          DateTime?
  reference          String?   @unique // "PO-3F9A2B"
  commissionDeducted Float     @default(0)
  adjustments        Float     @default(0)
  // Bank details AS AT payout time. Details change; a payout record must not.
  bankSnapshot       Json?
  gatewayRef         String?
  paidAt             DateTime?
  bookingIds         Json?

  batch PayoutBatch? @relation(fields: [batchId], references: [id])

  @@index([partnerId])
  @@index([batchId])
  @@index([status, scheduledDate])
}

// A payout run. Generated as a draft, reviewed, approved, then processed —
// approval is a deliberate second step; money never disburses automatically.
model PayoutBatch {
  id              String    @id @default(cuid())
  reference       String    @unique // "PB-2026W31"
  cycle           String // weekly | monthly | manual
  periodStart     DateTime
  periodEnd       DateTime
  status          String    @default("draft") // draft | approved | processing | completed | failed | cancelled
  partnerCount    Int       @default(0)
  totalGross      Float     @default(0)
  totalCommission Float     @default(0)
  totalNet        Float     @default(0)
  approvedById    String?
  approvedAt      DateTime?
  processedAt     DateTime?
  exportUrl       String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payouts PayoutRecord[]

  @@index([status, periodEnd])
}

// User.bankAccount is a single opaque string — not enough for a real transfer,
// which needs a bank code, an account name to match against, and a verification
// state. That column stays for backward compatibility; this is the real record.
model PartnerBankAccount {
  id              String    @id @default(cuid())
  partnerId       String    @unique
  bankName        String
  bankCode        String? // SWIFT / DuitNow proxy resolution
  accountNumber   String
  accountName     String // must match the partner's verified legal name
  accountType     String    @default("savings")
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  partner User @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([isVerified])
}

// ─── §5 Partner wallet & cash-commission settlement ──────────────────────────
// Online bookings: the consumer pays up front, ServisAku holds the money in
// EscrowLedger and pays the partner out net of commission — the platform is never
// owed anything. Cash bookings invert that: the partner collects the full fare at
// the door, so the *commission* becomes a debt the partner owes ServisAku. That
// debt lives in PartnerWallet.outstandingCommission and is cleared periodically
// through a CommissionSettlement.
//
// All amounts are MYR (see the units note on Payment).

model PartnerWallet {
  id                    String    @id @default(cuid())
  partnerId             String    @unique
  availableBalance      Float     @default(0) // released earnings, withdrawable
  pendingBalance        Float     @default(0) // earned but still held in escrow
  outstandingCommission Float     @default(0) // owed to ServisAku from cash jobs
  lifetimeEarnings      Float     @default(0)
  lifetimeCommission    Float     @default(0)
  // Grace before the overdue ladder starts — freezing a partner who owes RM 3 is
  // hostile and costs more in support than it recovers.
  creditLimit           Float     @default(50)
  settlementCycle       String    @default("weekly") // weekly | monthly
  nextSettlementDate    DateTime?
  isFrozen              Boolean   @default(false) // blocks new job dispatch
  payoutsSuspended      Boolean   @default(false)
  freezeReason          String?
  frozenAt              DateTime?
  currency              String    @default("MYR")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  partner     User                   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  entries     WalletLedgerEntry[]
  settlements CommissionSettlement[]

  @@index([isFrozen])
  @@index([nextSettlementDate])
}

// Append-only. Never UPDATE or DELETE a row — corrections are new `reversal` rows
// pointing at what they undo. `balanceAfter` makes any historical balance
// reproducible without replaying the whole table.
model WalletLedgerEntry {
  id           String   @id @default(cuid())
  walletId     String
  partnerId    String
  type         String // earning_credit | commission_debit | payout_debit | settlement_credit
  // | escrow_hold | escrow_release | refund_debit | damage_deduction | penalty | bonus
  // | adjustment | reversal | opening_balance
  direction    String // credit | debit
  bucket       String // available | pending | outstanding
  amount       Float
  balanceAfter Float // the bucket's balance immediately after this entry
  description  String
  bookingId    String?
  paymentId    String?
  payoutId     String?
  settlementId String?
  claimId      String?
  reversalOf   String? // WalletLedgerEntry.id this entry reverses
  createdById  String? // admin user id, for manual adjustments
  // Guards against double-crediting when a gateway redelivers a webhook. Composed
  // by the caller (e.g. "earning:<bookingId>") so the DB — not application logic —
  // enforces once-only semantics.
  idempotencyKey String? @unique
  metadata     Json?
  createdAt    DateTime @default(now())

  wallet PartnerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([bookingId])
  @@index([type])
}

model CommissionSettlement {
  id                  String    @id @default(cuid())
  walletId            String
  partnerId           String
  reference           String    @unique // "STL-2026W31-3F9A" — also the concurrency guard
  cycle               String // weekly | monthly
  periodStart         DateTime
  periodEnd           DateTime
  grossCashCollected  Float     @default(0)
  commissionDue       Float     @default(0)
  sstOnCommission     Float     @default(0) // ServisAku's commission is itself a taxable supply
  totalDue            Float     @default(0)
  amountPaid          Float     @default(0)
  status              String    @default("pending") // pending | partially_paid | paid | overdue | waived | written_off
  dueDate             DateTime
  paidAt              DateTime?
  paymentId           String? // Payment row of type 'commission_settlement'
  bookingIds          Json? // snapshot of the bookings rolled into this settlement
  remindersSent       Int       @default(0)
  lastReminderAt      DateTime?
  adminOverrideById   String?
  adminOverrideReason String?
  adminOverrideAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  wallet PartnerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([status, dueDate])
}

// Access-control record for an uploaded file. Appwrite Storage holds the bytes;
// this row decides who may read them. Files are never served from a public
// bucket URL — every read goes through GET /api/uploads/:fileId so the check
// happens per request.
model UploadedFile {
  id        String   @id @default(cuid())
  fileId    String   @unique // Appwrite Storage file id
  ownerId   String
  context   String   @default("general") // damage_claim | dispute | support | booking_photo | general
  filename  String
  mimeType  String
  sizeBytes Int
  kind      String // image | video | document
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([context])
}

// ─── §6 Malaysian taxation (SST) & invoicing ─────────────────────────────────
// Two distinct taxable supplies exist in this marketplace and must not be
// conflated: ServisAku → customer (the service fee) and ServisAku → partner
// (the commission, which is itself a taxable service).
//
// Rates are data, never literals: a booking made under a 6% regime must invoice
// at 6% forever. Invoices read Booking.priceBreakdown — the snapshot taken at
// booking time — and never recompute.

model TaxConfig {
  id             String    @id @default(cuid())
  code           String // SST_SERVICE | SST_COMMISSION
  rate           Float // 0.08
  registrationNo String? // ServisAku's SST registration number
  appliesTo      Json? // category/service slugs; null = all taxable supplies
  isInclusive    Boolean   @default(false) // displayed price already contains the tax
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime? // set when superseded — preserves the full rate history
  notes          String?
  createdAt      DateTime  @default(now())

  @@unique([code, effectiveFrom])
  @@index([code, isActive])
}

// Immutable once issued. A correction is a credit note referencing the original,
// never an edit — that is what makes the sequence auditable.
model Invoice {
  id                String   @id @default(cuid())
  invoiceNo         String   @unique // "INV-2026-000001" — sequential and gapless
  type              String   @default("tax_invoice") // tax_invoice | credit_note
  bookingId         String?
  consumerId        String?
  partnerId         String? // set on commission/settlement invoices
  settlementId      String?
  paymentId         String?
  // Amounts in MYR, copied from the booking's price snapshot.
  subtotal          Float
  discountTotal     Float    @default(0)
  platformFee       Float    @default(0)
  taxableAmount     Float
  sstRate           Float
  sstAmount         Float
  total             Float
  currency          String   @default("MYR")
  refundedAmount    Float    @default(0)
  // Party snapshots — an invoice must not change when a profile is edited.
  supplierName      String
  supplierAddress   String?
  sstRegistrationNo String?
  customerName      String
  customerAddress   String?
  customerPhone     String?
  customerEmail     String?
  lineItems         Json // [{ description, qty, unitPrice, amount, taxable }]
  creditNoteFor     String? // Invoice.id this credit note reverses
  reason            String? // credit-note reason
  issuedAt          DateTime @default(now())
  pdfUrl            String?
  createdAt         DateTime @default(now())

  @@index([bookingId])
  @@index([consumerId, issuedAt])
  @@index([partnerId, issuedAt])
  @@index([type, issuedAt])
}

model ChatMessage {
  id         String    @id @default(cuid())
  bookingId  String
  senderId   String
  senderName String
  senderRole String?
  message    String
  type       String    @default("text")
  fileUrl    String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

model PartnerLocation {
  id          String   @id @default(cuid())
  partnerId   String   @unique
  partnerName String?
  lat         Float?
  lng         Float?
  isOnline    Boolean  @default(false)
  isOnJob     Boolean  @default(false)
  lastSeen    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  role      String   @default("consumer") // recipient role snapshot: consumer | partner
  title     String
  body      String
  type      String   @default("info") // legacy coarse type; `category` is the canonical bucket
  category  String   @default("system") // bookings | jobs | payments | wallet | promotions | support | security | reviews | system
  priority  String   @default("normal") // low | normal | high | urgent
  icon      String? // emoji or icon key rendered on the card
  image     String? // optional hero image URL
  actionUrl String? // deep link / route the CTA opens (canonical; `link` kept as alias)
  link      String? // legacy alias of actionUrl
  bookingId String?
  paymentId String?
  metadata  Json? // arbitrary structured payload (serviceName, otp, amount, ctaLabel, …)
  channel   String   @default("in_app") // in_app | email | sms | push (primary delivery channel of this record)
  isRead    Boolean  @default(false)
  isArchived Boolean @default(false)
  deliveryStatus String @default("sent") // queued | sent | delivered | failed
  scheduledAt DateTime? // set for future-dated notifications not yet released
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, isArchived, createdAt])
  @@index([userId, category])
  @@index([bookingId])
}

// Per-user notification channel + category preferences and quiet-hours.
model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  // Delivery channels
  pushEnabled      Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  smsEnabled       Boolean  @default(true)
  // Category toggles
  bookingEnabled   Boolean  @default(true) // consumer bookings / partner jobs
  paymentEnabled   Boolean  @default(true)
  promotionEnabled Boolean  @default(true)
  walletEnabled    Boolean  @default(true)
  supportEnabled   Boolean  @default(true)
  securityEnabled  Boolean  @default(true) // security alerts are always delivered in-app regardless
  reviewEnabled    Boolean  @default(true)
  // Device behaviour
  soundEnabled     Boolean  @default(true)
  vibrationEnabled Boolean  @default(true)
  doNotDisturb     Boolean  @default(false)
  dndStart         String? // "22:00" — quiet-hours window start (user local time)
  dndEnd           String? // "07:00"
  language         String   @default("en")
  timezone         String   @default("Asia/Kuala_Lumpur")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Registered device/browser push tokens (FCM / Web Push). One user → many devices.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("web") // web | ios | android
  provider  String   @default("fcm") // fcm | webpush | expo
  deviceId  String? // optional stable device identifier for dedupe
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── §2 Booking line items ───────────────────────────────────────────────────

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  kind      String // package | addon | fee | discount
  refId     String? // ServicePackage.id / ServiceAddon.id when applicable
  label     String
  labelMy   String?
  qty       Int     @default(1)
  unitPrice Float
  total     Float
  status    String  @default("approved") // approved | pending | rejected — mid-job extras await customer approval
  addedBy   String? // user id who proposed the item (partner, for extras)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─── §3 Catalog (DB-driven service abstraction — see docs/04) ────────────────

model ServiceCategory {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  nameMy             String
  tagline            String?
  taglineMy          String?
  iconKey            String   @default("Home")
  accent             String   @default("emerald")
  heroImage          String?
  headerImage        String?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  emergencySupported Boolean  @default(false)
  recurringSupported Boolean  @default(false)
  priceFrom          Float    @default(0)
  workflowConfig     Json? // booking steps + job lifecycle + completion requirements
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subcategories Subcategory[]
  services      Service[]
  bookings      Booking[]
}

model Subcategory {
  id         String @id @default(cuid())
  categoryId String
  slug       String
  name       String
  nameMy     String
  iconKey    String @default("Home")
  sortOrder  Int    @default(0)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

model Service {
  id            String   @id @default(cuid())
  slug          String   @unique
  categoryId    String
  subcategoryId String?
  name          String
  nameMy        String
  description   String   @default("")
  descriptionMy String   @default("")
  basePrice     Float
  pricingModel  String   @default("flat") // flat | per_unit | area_based | hourly | quote (legacy package engine)
  pricingConfig Json? // model-specific params (tier table, unit price, hourly rate…)
  // ── Dynamic booking-engine fields (booking-flows.md) ──────────────────────
  // pricingType drives computePrice() in server/lib/dynamicPricing.js; questions
  // below define Step A. Nullable so legacy package/addon services are unaffected.
  pricingType     String? // FIXED | PER_UNIT | TIERED | PER_SQFT | PER_HOUR | DIAGNOSTIC | BASE_PLUS_ADDONS | TIER_QUANTITY
  unitPrice       Float? // PER_UNIT default unit price (display/metadata)
  rate            Float? // PER_SQFT rate/sqft or PER_HOUR rate/hr (display/metadata)
  visitFee        Float    @default(0)
  minQty          Int      @default(1)
  sstEnabled      Boolean  @default(false)
  convertsToQuote Boolean  @default(false) // large jobs may convert to a custom site quote
  durationMin   Int      @default(60)
  durationMax   Int      @default(120)
  image         String?
  attributes    Json? // propertyTypes, bookingModes, cities, partnerSkills, safetyChecks
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        ServiceCategory  @relation(fields: [categoryId], references: [id])
  packages        ServicePackage[]
  addons          ServiceAddon[]
  questions       BookingQuestion[]
  bookings        Booking[]
  specializations PartnerSpecialization[]

  @@index([categoryId, isActive])
}

// ─── §4 Dynamic Step-A questions (DB-driven booking engine) ──────────────────
// A service's Step A is a list of these; everything else (Steps B–F) is universal.
// `key` is the stable answer key used in Booking.details / price snapshots.
model BookingQuestion {
  id         String  @id @default(cuid())
  serviceId  String
  key        String // answer key ("length", "qty", "units")
  label      String
  type       String // TIER_SELECT | SINGLE_SELECT | MULTI_SELECT | QUANTITY | TIER_QUANTITY | AREA_INPUT | HOURS_INPUT | INFO
  required   Boolean @default(true)
  sortOrder  Int     @default(0)
  config     Json? // { min, max, step, unit, pricePerUnit, ratePerSqft, ratePerHour, perUnit, perSqft }

  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@unique([serviceId, key])
  @@index([serviceId, sortOrder])
}

model QuestionOption {
  id                   String  @id @default(cuid())
  questionId           String
  key                  String // option key ("short", "1_5hp")
  label                String
  priceModifier        Float   @default(0) // SELECT/TIER_SELECT flat add (TIER_SELECT sets base)
  unitPrice            Float? // TIER_QUANTITY per-option unit price
  priceModifierPerSqft Float? // AREA_INPUT companion SELECTs: per-sqft add/subtract
  isDefault            Boolean @default(false)
  sortOrder            Int     @default(0)

  question BookingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
}

model ServicePackage {
  id           String  @id @default(cuid())
  serviceId    String
  tier         String // essential | signature | premium | custom slug
  name         String
  nameMy       String
  description  String  @default("")
  descriptionMy String @default("")
  price        Float? // absolute price (packageData style) …
  multiplier   Float? // … or multiplier on Service.basePrice (catalog style); one required
  inclusions   Json    @default("[]")
  inclusionsMy Json    @default("[]")
  exclusions   Json?
  warrantyDays Int?
  isPopular    Boolean @default(false)
  sortOrder    Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, tier])
}

model ServiceAddon {
  id          String @id @default(cuid())
  serviceId   String
  slug        String
  name        String
  nameMy      String
  price       Float
  durationMin Int    @default(0)
  isActive    Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, slug])
}

model PriceRule {
  id         String    @id @default(cuid())
  scope      String // category | service | city | global
  scopeId    String?
  type       String // surge | city_adjust | promo_window
  config     Json
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
}

// Which services a partner is qualified to perform. Dispatch/matching filters on
// (serviceId, verifiedByAdmin) so only admin-vetted partners are offered a job.
model PartnerSpecialization {
  id              String   @id @default(cuid())
  partnerId       String
  serviceId       String
  verifiedByAdmin Boolean  @default(false)
  yearsExperience Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner User    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([partnerId, serviceId])
  @@index([serviceId, verifiedByAdmin, isActive])
}
