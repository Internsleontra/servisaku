#env
.env
.env.*
# build-target selectors (no secrets) — keep these tracked
!.env.consumer
!.env.partner

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite
scratch/
/index

# local dev database (use Postgres via DATABASE_URL)
prisma/dev.db
prisma/*.db

# Financial remediation run artifacts (pre-migration snapshots, correction and
# reconciliation logs). These contain live partner and banking data — partnerName,
# bankSnapshot — from the dev database and must NEVER be committed.
# Keep them on disk: prisma/migrations/20260813000000_financial_naming_and_commission
# cites them as the pre-migration capture, and they are the rollback evidence.
.backups/

# Firebase Admin service-account key — NEVER commit
serviceAccountKey.json
*serviceAccount*.json
firebase-adminsdk*.json

# Python (backend/)
__pycache__/
*.pyc
.pytest_cache/
.venv/
.coverage
htmlcov/

# Netlify CLI build state — machine-local, contains absolute paths
.netlify/
