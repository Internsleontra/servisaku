# Copy this to .env and fill in real values

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/servisaku

# JWT Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase (optional, for file storage)
SUPABASE_URL=
SUPABASE_KEY=

# Payments — Billplz SANDBOX. Sign up free at https://www.billplz-sandbox.com
# using intern@leontra.com, create a Collection, then fill these in:
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=

# Payments — iPay88. No self-serve sandbox exists; requires a manually-approved
# merchant account from support@ipay88.com.my. Leave blank until obtained —
# the iPay88 gateway is stubbed (returns 503) until these are set.
IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=

# Public URL this server is reachable at, so Billplz can reach the callback
# endpoint. In local dev this needs a tunnel (e.g. ngrok) — Billplz cannot
# reach http://localhost. Use POST /payments/{id}/sync to verify manually
# in the meantime.
APP_PUBLIC_BASE_URL=http://localhost:8000

PAYMENT_CURRENCY=MYR

# CORS
ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Debug mode
DEBUG=true
